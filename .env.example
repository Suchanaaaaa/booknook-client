# MongoDB used by Better Auth (Next.js)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/booknook
MONGODB_DB=booknook
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Must exactly match server/.env API_JWT_SECRET
API_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000
# Google OAuth credentials from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# imgbb API key (book cover uploads)
IMGBB_API_KEY=
